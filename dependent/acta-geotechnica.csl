<?xml version="1.0" encoding="utf-8"?>
<citation-style xmlns="http://purl.org/net/xbiblio/csl">
  <info>
    <title>Numeric with Alphabetical References</title>
    <id>http://www.zotero.org/styles/numeric-alphabetical</id>
    <link href="http://www.zotero.org/styles/numeric-alphabetical" rel="self"/>
    <author>
      <name>OpenAI</name>
    </author>
    <category citation="numeric"/>
    <category bibliography="alphabetic"/>
    <updated>2025-05-11</updated>
  </info>

  <!-- Citation Format -->
  <citation et-al-min="3" et-al-use-first="1">
    <layout suffix=" " delimiter=", ">
      <text variable="author" suffix=" " />
      <date prefix="(" suffix=")" />
    </layout>
  </citation>

  <!-- Bibliography (Reference List) Format -->
  <bibliography>
    <sort>
      <!-- Sort by author alphabetically -->
      <key variable="author" />
      <key variable="title" />
    </sort>
    <layout>
      <group delimiter=". ">
        <text variable="author" />
        <text variable="year" prefix="(" suffix=")" />
        <text variable="title" />
        <text variable="container-title" prefix=" " />
        <text variable="volume" prefix="Vol. " />
        <text variable="issue" prefix="No. " />
        <text variable="page" prefix="pp. " />
        <text variable="DOI" prefix="https://doi.org/" />
      </group>
    </layout>
  </bibliography>
</citation-style>
